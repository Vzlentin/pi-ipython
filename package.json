{
  "name": "pi-ipython",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent IPython kernel tool for Pi",
  "keywords": [
    "pi-package",
    "ipython"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:kernel": "node --no-warnings tests/test_kernel.mjs && node --no-warnings tests/test_cells.mjs --kernel",
    "test:persistence": "node --no-warnings tests/test_persistence.mjs && node --no-warnings tests/test_branches.mjs && node --no-warnings tests/test_checkpoint_limits.mjs",
    "test": "npm run typecheck && npm run test:kernel && npm run test:persistence"
  },
  "pi": {
    "extensions": [
      "./extensions/ipython.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "22.19.7",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
